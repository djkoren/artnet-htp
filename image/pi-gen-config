# pi-gen configuration for the artnet-htp image build.
#
# This file is sourced as bash by pi-gen's build.sh. Keep it minimal — every
# knob here changes the build surface area and we want reproducibility.
#
# Reference: https://github.com/RPi-Distro/pi-gen/blob/arm64/README.md

# Image identity
IMG_NAME=artnet-htp
RELEASE=bookworm

# Stage list:
#   stage0 = bootstrap (debootstrap)
#   stage1 = base system
#   stage2 = lite (server-style, no desktop)
#   stage-artnet-htp = our custom stage (added in plan step 5; empty in step 4)
#
# Skip stage3..stage5 (desktop variants) — we ship Lite only.
# stage-artnet-htp is our custom stage; it's a no-op when the directory contains
# only a placeholder (step 4 verification). Step 5 fills it in.
STAGE_LIST="stage0 stage1 stage2 stage-artnet-htp"

# Hostname baked into the image. Avahi/mDNS lets you reach it via
# http://artnet-htp.local:8080 on any LAN that has mDNS working (most do).
TARGET_HOSTNAME=artnet-htp

# SSH ON by default. The image ships flash-and-go (FPP-style), so the
# operator can reach the Pi over the LAN without a monitor+keyboard. If
# you want to lock this down for a specific deployment, change `htp`'s
# password (`passwd htp`) and/or `systemctl disable ssh` post-boot.
ENABLE_SSH=1

# Default login credentials baked into the image (matches the FPP model:
# fpp/falcon). Username/password are advertised in the README so any
# operator can flash and immediately SSH in.
#
#   username: htp
#   password: artnet
#
# DISABLE_FIRST_BOOT_USER_RENAME=1 stops pi-gen from installing the
# userconfig.service that hijacks tty1 on first boot demanding a fresh
# username + password — we already have a working account, no prompt
# needed.
#
# SECURITY NOTE: identical default creds on every unit is fine for a LAN-
# only production-show Pi. If you bridge a unit to the public internet,
# change the password (`sudo passwd htp`) or disable SSH.
#
# The `htp` user is the login account. A separate non-login system user
# `artnet` (no shell, no password) is created in stage-artnet-htp and
# runs the merger service.
FIRST_USER_NAME=htp
FIRST_USER_PASS=artnet
DISABLE_FIRST_BOOT_USER_RENAME=1

# Locale / timezone — minimal to keep image small.
LOCALE_DEFAULT=en_US.UTF-8
TIMEZONE_DEFAULT=Etc/UTC
KEYBOARD_KEYMAP=us
KEYBOARD_LAYOUT="English (US)"

# Compress the output. xz with -9 gives ~50% size reduction.
DEPLOY_COMPRESSION=xz
COMPRESSION_LEVEL=6
