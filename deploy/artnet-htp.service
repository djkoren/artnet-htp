[Unit]
Description=ArtNet HTP Merger
Documentation=https://art-net.org.uk/
After=network-online.target
Wants=network-online.target
# Defense against runaway crash-loops: stop trying after 10 failures in
# 5 minutes. v0.2.4 hit a restart counter of 143 before we caught a bad
# bind_ip in the wild. The fix (always-bind-0.0.0.0 receiver) makes that
# class of failure impossible, but capping retries is cheap insurance.
StartLimitBurst=10
StartLimitIntervalSec=300

[Service]
Type=simple
User=artnet
Group=artnet
WorkingDirectory=/opt/artnet-htp
# Belt-and-suspenders for port 80 binding: the image stage already runs
# setcap on .venv/bin/python during build, but if pi-gen's ext4 packaging
# strips the security.capability xattr (it has occasionally been reported
# to), the service would crash on bind. Re-apply at every start as root
# (the `+` prefix runs with the unit's full privileges before dropping
# to User=artnet). Idempotent: a no-op when the cap is already in place.
ExecStartPre=+/usr/sbin/setcap cap_net_bind_service=+ep /opt/artnet-htp/.venv/bin/python
ExecStart=/opt/artnet-htp/.venv/bin/artnet-htp --config /etc/artnet-htp/config.yaml
Restart=always
RestartSec=2

# Logs go to journald (view with: journalctl -u artnet-htp -f)
StandardOutput=journal
StandardError=journal

# Lock-down (kept minimal). Background: any directive that installs a
# seccomp filter (RestrictNamespaces, LockPersonality, RestrictRealtime,
# RestrictSUIDSGID, MemoryDenyWriteExecute, SystemCallFilter, ...) makes
# systemd call prctl(PR_SET_NO_NEW_PRIVS, 1) before exec. That kernel
# flag strips file capabilities at exec — so our file cap on
# .venv/bin/python (for port-80 bind) silently doesn't apply, AND sudo
# can't elevate (so the Network panel's `sudo nmcli` fails). v0.3.3
# left these enabled and the merger crashed with EACCES on bind 80.
#
# We're a single-purpose LAN appliance. Filesystem protection
# (ProtectSystem=strict + ReadWritePaths) doesn't use seccomp, so it
# stays — that's where most of the real value was anyway.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/artnet-htp /var/log/artnet-htp /opt/artnet-htp

[Install]
WantedBy=multi-user.target
