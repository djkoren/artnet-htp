[Unit]
Description=ArtNet HTP Merger
Documentation=https://art-net.org.uk/
After=network-online.target
Wants=network-online.target
# Defense against runaway crash-loops: stop trying after 10 failures in
# 5 minutes. v0.2.4 hit a restart counter of 143 before we caught a bad
# bind_ip in the wild. The fix (always-bind-0.0.0.0 receiver) makes that
# class of failure impossible, but capping retries is cheap insurance.
StartLimitBurst=10
StartLimitIntervalSec=300

[Service]
Type=simple
User=artnet
Group=artnet
WorkingDirectory=/opt/artnet-htp
ExecStart=/opt/artnet-htp/.venv/bin/artnet-htp --config /etc/artnet-htp/config.yaml
Restart=always
RestartSec=2

# Logs go to journald (view with: journalctl -u artnet-htp -f)
StandardOutput=journal
StandardError=journal

# Lock-down (best-effort — we still need network and the binary).
# NoNewPrivileges stays off so `sudo nmcli` (used by the Network panel)
# can elevate. v0.3.0 used AmbientCapabilities for port 80, but ambient
# caps implicitly trigger PR_SET_NO_NEW_PRIVS at the kernel level — which
# blocks sudo even with NoNewPrivileges=false in the unit. v0.3.2 moved
# the port-80 grant to a file capability on .venv/bin/python (set by
# stage-artnet-htp), which doesn't have that side effect.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/artnet-htp /var/log/artnet-htp /opt/artnet-htp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false  # uvicorn uses some JIT-ish things; keep this off
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
