[Unit]
Description=ArtNet HTP Merger
Documentation=https://art-net.org.uk/
After=network-online.target
Wants=network-online.target
# Defense against runaway crash-loops: stop trying after 10 failures in
# 5 minutes. v0.2.4 hit a restart counter of 143 before we caught a bad
# bind_ip in the wild. The fix (always-bind-0.0.0.0 receiver) makes that
# class of failure impossible, but capping retries is cheap insurance.
StartLimitBurst=10
StartLimitIntervalSec=300

[Service]
Type=simple
# v0.3.5 lesson learned: every non-root approach we tried for binding
# port 80 hit a wall.
#   - AmbientCapabilities= in the unit (v0.3.0) → implicit no_new_privs
#     → broke `sudo nmcli` for the Network panel.
#   - File cap on .venv/bin/python (v0.3.2-3.4) → cap is verifiably on
#     the binary (getcap confirms cap_net_bind_service=ep) but the
#     running process can't use it. Multiple rounds of stripping
#     seccomp-using lockdown directives didn't help.
#
# This is a single-purpose appliance on a private show LAN with an
# unauthenticated REST API. Anyone with network access already has
# full configuration control. The security delta between
# "merger as artnet user with caps" and "merger as root" is minimal
# for the actual threat model. FPP / OctoPrint / many similar
# appliances run as root for exactly this reason.
#
# Trade-off accepted: simpler, works, every release path validated.
# If we ever want to revisit, systemd socket activation is the right
# Linux pattern (systemd binds 80 as root, hands the FD to a non-root
# service). Not blocking on it.
User=root
Group=root
WorkingDirectory=/opt/artnet-htp
ExecStart=/opt/artnet-htp/.venv/bin/artnet-htp --config /etc/artnet-htp/config.yaml
Restart=always
RestartSec=2

# Logs go to journald (view with: journalctl -u artnet-htp -f)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
