[Unit]
Description=ArtNet HTP Merger
Documentation=https://art-net.org.uk/
After=network-online.target
Wants=network-online.target
# Defense against runaway crash-loops: stop trying after 10 failures in
# 5 minutes. v0.2.4 hit a restart counter of 143 before we caught a bad
# bind_ip in the wild. The fix (always-bind-0.0.0.0 receiver) makes that
# class of failure impossible, but capping retries is cheap insurance.
StartLimitBurst=10
StartLimitIntervalSec=300

[Service]
Type=simple
User=artnet
Group=artnet
WorkingDirectory=/opt/artnet-htp
ExecStart=/opt/artnet-htp/.venv/bin/artnet-htp --config /etc/artnet-htp/config.yaml
Restart=always
RestartSec=2

# Logs go to journald (view with: journalctl -u artnet-htp -f)
StandardOutput=journal
StandardError=journal

# Lock-down (best-effort — we still need network and the binary)
# NoNewPrivileges has to stay OFF because it strips AmbientCapabilities,
# which we need to bind port 80 as a non-root user.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/artnet-htp /var/log/artnet-htp /opt/artnet-htp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false  # uvicorn uses some JIT-ish things; keep this off
RestrictRealtime=true
RestrictSUIDSGID=true

# UDP 6454 (ArtNet) is unprivileged. Port 80 (default web UI) requires
# CAP_NET_BIND_SERVICE — the unit grants it ambiently so the `artnet`
# user can bind it without sudo.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
